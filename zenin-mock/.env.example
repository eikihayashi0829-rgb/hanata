# LINE Messaging API
# https://developers.line.biz/console/ で Messaging API チャネルを作成
# Channel basic settings → Channel secret
LINE_CHANNEL_SECRET=your_channel_secret_here
# Messaging API → Channel access token (long-lived) → Issue
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here

# OpenAI (画像解析用) — 未設定でもキーワードベースの簡易判定で動作します
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 任意。デフォルトは gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
